APP_NAME=Tikooh
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Nairobi

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:3000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database ────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tikooh
DB_USERNAME=tikooh
DB_PASSWORD=

# ── Queue, cache, session ───────────────────────────────────────────────────
# Campaign sends and badge rendering run on the queue: `php artisan queue:work`
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# ── Reverb (websockets: live polls, Q&A, chat, door feed) ───────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tikooh
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# ── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@tikooh.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# ── Integrations ────────────────────────────────────────────────────────────
# These are PLATFORM-WIDE FALLBACKS ONLY. Per-tenant credentials belong in the
# integration_credentials table, where they are encrypted at rest. Nothing here
# is ever sent to the browser.

# Anthropic — powers the Tikooh chatbot (feature 12)
ANTHROPIC_API_KEY=

# Pesapal v3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_SANDBOX=true

# Safaricom Daraja (M-Pesa STK push)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_SANDBOX=true

# Advanta bulk SMS
ADVANTA_API_KEY=
ADVANTA_PARTNER_ID=
ADVANTA_SHORTCODE=TIKOOH
